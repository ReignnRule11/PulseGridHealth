# Use a dedicated PostgreSQL database and a non-superuser application role.
# In production the role must be NOBYPASSRLS; never use a database superuser.
DATABASE_URL=postgresql+psycopg://pulsegrid:CHANGE_ME@localhost:5432/pulsegrid_dev
APP_ENV=development
# Exact browser origin(s), comma-separated. Production must use HTTPS.
CORS_ORIGINS=http://localhost:3000
# Generate a long random secret; required only for the one-time organization bootstrap.
BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72
MAX_UPLOAD_MB=5
MIN_BASELINE_POINTS=6
ANOMALY_Z_THRESHOLD=3.5
MIN_WORKFORCE_COHORT_SIZE=20

# AI alert explanations are disabled until a provider and governance review are configured.
AI_ENABLED=false
AI_PROVIDER_NAME=openai_compatible
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20

# Transactional email is required for email verification and password recovery.
# Configure these as private Render environment variables (never commit real values).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
