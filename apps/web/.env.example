# Server-side Next.js rewrite target. Local development can point to local FastAPI.
# In Vercel, set this to the Render HTTPS origin, e.g. https://your-api.onrender.com.
API_BACKEND_ORIGIN=http://127.0.0.1:8000

# Leave NEXT_PUBLIC_API_URL unset in production so the browser uses same-origin /api/* paths.
# Optional only for local debugging without the Next.js rewrite:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
